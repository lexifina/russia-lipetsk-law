?Block=region48&DocumentTypes=8fb60238-9fee-4a1b-9534-6d99ad0ceff0&DocumentTypes=97d902b9-cc94-4b01-9576-b4a7d4fde1fb&DocumentTypes=c0281bbe-6be1-45be-8acd-f319c99b85ad&DocumentTypes=50acf12d-2461-466e-bada-de5d8b7737a1&DocumentTypes=1ee8f2cc-d23f-4ac1-a0e4-1fd202ecc736&DocumentTypes=5cf51861-5b6f-4210-9776-8086c05fdc8b&DocumentTypes=cdafe085-10fe-4199-92a5-9aa82b2b6c99&DocumentTypes=bdfe8274-cfc2-4a62-b413-91a201646ced&DocumentTypes=8910e61f-371d-490c-a1b8-aa7b8a5a48be&DocumentTypes=e880fa45-e4f4-4db9-bba0-847666adebab&DocumentTypes=16b9a101-4ce2-47d0-8a92-8b1aff72867a&PageSize=200&Index=9&SortedBy=5&SortDestination=asc"}, {"at": "2026-11-24T14:12:31Z", "bytes": 1348, "method": "GET", "status": 200, "url": "http://publication.pravo.gov.ru/api/Document?eoNumber=4800201504300014"}, {"at": "2026-11-24T14:12:34Z", "bytes": 2154, "method": "GET", "status": 200, "url": "http://publication.pravo.gov.ru/api/Document?eoNumber=4800202611180004"}], "runner": "lawwatch russia (65e3dde363)", "schema": "lexifina-check/1", "seen": {"added": ["4800202611100001", "4800202611130002", "4800202611160006", "4800202611170001", "4800202611170002", "4800202611170003", "4800202611180001", "4800202611180002", "4800202611180003", "4800202611180004", "4800202611180005", "4800202611180006", "4800202611180007", "4800202611180008", "4800202611180009", "4800202611180010", "4800202611180011", "4800202611180012", "4800202611180013", "4800202611180014", "4800202611180015", "4800202611180016", "4800202611180017", "4800202611180018", "4800202611180019", "4800202611180020", "4800202611180021", "4800202611180022"], "changed": [], "removed": []}, "snapshot": "1686 law-type documents in block region48; newest published 2026-11-18", "source": "pravo-lipetsk", "started": "2026-11-24T14:10:53Z", "titles": {"4800202611100001": "О внесении изменений в Закон Липецкой области \"Об областном бюджете на 2026 год и на плановый период 2027 и 2028 годов\"", "4800202611130002": "Об утверждении заключения дополнительного соглашения к концессионному соглашению в отношении создания, реконструкции и эксплуатации отдельных объектов централиз", "4800202611160006": "О внесении изменений в Закон Липецкой области \"О бюджете территориального фонда обязательного медицинского страхования Липецкой области на 2026 год и на плановы", "4800202611170001": "О внесении изменений в Закон Липецкой области \"Об установлении налоговой ставки для организаций и индивидуальных предпринимателей, применяющих упрощенную систем", "4800202611170002": "О поправках к Уставу Липецкой области Российской Федерации", "4800202611170003": "О внесении изменений в Закон Липецкой области \"О бюджетном процессе Липецкой области\"", "4800202611180001": "О внесении изменения в статью 2 Закона Липецкой области \"Об установлении коэффициента, отражающего региональные особенности рынка труда на территории Липецкой о", "4800202611180002": "О внесении изменений в Закон Липецкой области \"О налоге на имущество организаций в Липецкой области\"", "4800202611180003": "О внесении изменений в Закон Липецкой области \"О наделении органов местного самоуправления отдельными государственными полномочиями Липецкой области по организа", "4800202611180004": "О внесении изменений в Закон Липецкой области \"О наделении органов местного самоуправления отдельными государственными полномочиями по организации мероприятий п", "4800202611180005": "О внесении изменений в Закон Липецкой области \"О государственной социальной помощи\"", "4800202611180006": "О внесении изменений в Закон Липецкой области \"О предоставлении государственной поддержки отдельным категориям граждан на газификацию жилого помещения\"", "4800202611180007": "О регулировании отдельных вопросов, связанных с оборотом табачной продукции и никотинсодержащей продукции на территории Липецкой области", "4800202611180008": "О прекращении осуществления органами местного самоуправления Лев-Толстовского муниципального района Липецкой области Российской Федерации отдельных государствен", "4800202611180009": "О внесении изменений в Закон Липецкой области \"О гарантиях осуществления полномочий депутата представительного органа муниципального образования Липецкой област", "4800202611180010": "О территориальной организации местного самоуправления на территории муниципального образования Лев-Толстовский муниципальный район Липецкой области Российской Ф", "4800202611180011": "Об утверждении заключения дополнительного соглашения к концессионному соглашению от 5 октября 2022 года о создании, реконструкции и эксплуатации объектов трансп", "4800202611180012": "О внесении изменений в статьи 18 и 23 Закона Липецкой области \"О границах муниципальных образований Липецкой области\"", "4800202611180013": "О регулировании отдельных вопросов в сфере увековечения памяти жертв геноцида советского народа в период Великой Отечественной войны 1941 - 1945 годов на террит", "4800202611180014": "О внесении изменений в Закон Липецкой области \"О социальной поддержке обучающихся образовательных организаций в Липецкой области\"", "4800202611180015": "О внесении изменений в Закон Липецкой области \"О наделении органов местного самоуправления отдельными государственными полномочиями по возмещению стоимости услу", "4800202611180016": "О внесении изменений в Закон Липецкой области \"О гарантиях осуществления полномочий выборного должностного лица местного самоуправления и мерах по материальному", "4800202611180017": "Об утверждении заключения дополнительного соглашения к концессионному соглашению в отношении объекта образования - общеобразовательная школа на 1500 мест по адр", "4800202611180018": "О внесении изменения в статью 11.3 Закона Липецкой области \"О мерах социальной поддержки отдельных категорий граждан в связи с проведением специальной военной о", "4800202611180019": "О внесении изменений в Закон Липецкой области \"О правовом регулировании некоторых вопросов в сфере осуществления охоты на территории Липецкой области\"", "4800202611180020": "О мерах социальной поддержки от